{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/",
      "destination": "https://healpipe-ai.onrender.com/"
    },
    {
      "source": "/:path*",
      "destination": "https://healpipe-ai.onrender.com/:path*"
    }
  ]
}
